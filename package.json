{
  "name": "nuvio-anime-sources",
  "version": "1.0.0",
  "description": "Modular anime sources for Nuvio",
  "scripts": {
    "build": "node build.js",
    "build:watch": "nodemon --watch src -e js,json --exec 'node build.js'",
    "build:provider": "node build.js",
    "start": "node server.js",
    "test": "node tests/contract.js",
    "test:sources": "node tests/source-smoke.js"
  },
  "devDependencies": {
    "cheerio": "^1.1.2",
    "cheerio-without-node-native": "^0.20.2",
    "esbuild": "^0.20.0",
    "nodemon": "^3.0.0"
  },
  "keywords": [
    "nuvio",
    "streaming",
    "providers"
  ],
  "license": "GPL-3.0"
}
